{
  "name": "backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "start": "drizzle-kit migrate && bun run src/index.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.5",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.10.8",
    "pg": "^8.16.3",
    "postgres": "^3.4.7",
    "zod": "^4.1.13"
  }
}
